<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="174dp"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:background="@drawable/bg_focus"
    android:padding="4dp"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_adwio"/>

        <TextView
            android:id="@+id/favoriteText"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:background="#99000000"
            android:text="☆"
            android:textColor="@color/adwio_cyan"
            android:textSize="20sp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/adwio_text"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/posterMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/adwio_muted"
        android:textSize="9sp"/>
</LinearLayout>
