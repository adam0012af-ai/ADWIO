<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_adwio"
                android:scaleType="centerInside"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ADWIO"
                android:textColor="@color/adwio_text"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_discover_title"
                    android:textColor="@color/adwio_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/expiryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/adwio_muted"
                    android:textSize="9sp"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/adwio_text"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/adwio_muted"
                    android:textSize="8sp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="@string/search"
                android:padding="9dp"
                android:src="@drawable/ic_search_modern"/>

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="Refresh content"
                android:padding="9dp"
                android:src="@drawable/ic_refresh_modern"/>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="@string/settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings_modern"/>

            <ImageButton
                android:id="@+id/userInfoButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="User information"
                android:padding="9dp"
                android:src="@drawable/ic_user_modern"/>

            <ImageButton
                android:id="@+id/switchAccountButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_top_icon"
                android:contentDescription="Switch playlist"
                android:padding="9dp"
                android:src="@drawable/ic_switch_modern"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <FrameLayout
                android:id="@+id/liveCard"
                android:layout_width="0dp"
                android:layout_height="210dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.11"
                    android:padding="18dp"
                    android:src="@drawable/ic_live_modern"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_live_modern"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="@string/live_title" android:textColor="@color/adwio_text" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/liveCountText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/moviesCard"
                android:layout_width="0dp"
                android:layout_height="210dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.11"
                    android:padding="18dp"
                    android:src="@drawable/ic_movie_modern"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_movie_modern"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="@string/movies_title" android:textColor="@color/adwio_text" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/moviesCountText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/seriesCard"
                android:layout_width="0dp"
                android:layout_height="210dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.11"
                    android:padding="18dp"
                    android:src="@drawable/ic_series_modern"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_series_modern"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="@string/series_title" android:textColor="@color/adwio_text" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/seriesCountText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
