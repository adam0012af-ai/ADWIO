<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_gradient">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="22dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live TV"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/adwio_text"/>

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Select a channel"
                android:textColor="@color/adwio_muted"
                android:textSize="12sp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contentRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingBottom="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/rightMenu"
        android:layout_width="205dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="#E0120E20"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_adwio"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADWIO"
            android:textColor="@color/adwio_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/menuLive" style="@style/MenuButton" android:text="LIVE TV"/>
        <Button android:id="@+id/menuMovies" style="@style/MenuButton" android:text="MOVIES"/>
        <Button android:id="@+id/menuSeries" style="@style/MenuButton" android:text="SERIES"/>
        <Button android:id="@+id/menuSearch" style="@style/MenuButton" android:text="SEARCH"/>
        <Button android:id="@+id/menuFavorites" style="@style/MenuButton" android:text="FAVORITES"/>
        <Button android:id="@+id/menuSettings" style="@style/MenuButton" android:text="SETTINGS"/>
    </LinearLayout>
</LinearLayout>
