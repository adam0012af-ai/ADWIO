<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/bg_gradient">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:padding="34dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView android:id="@+id/titleText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Live TV" android:textSize="32sp" android:textStyle="bold"
                android:textColor="@color/adwio_text"/>
            <TextView android:id="@+id/subtitleText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Select a channel"
                android:textColor="@color/adwio_muted" android:textSize="15sp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contentRecycler"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:layout_marginTop="24dp"
                android:clipToPadding="false" android:paddingBottom="24dp"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/rightMenu"
        android:layout_width="260dp" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp"
        android:background="#D9120E20" android:gravity="center_horizontal">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_adwio"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ADWIO" android:textColor="@color/adwio_text"
            android:textSize="21sp" android:textStyle="bold" android:layout_marginBottom="28dp"/>
        <Button android:id="@+id/menuLive" style="@style/MenuButton" android:text="LIVE TV"/>
        <Button android:id="@+id/menuMovies" style="@style/MenuButton" android:text="MOVIES"/>
        <Button android:id="@+id/menuSeries" style="@style/MenuButton" android:text="SERIES"/>
        <Button android:id="@+id/menuSearch" style="@style/MenuButton" android:text="SEARCH"/>
        <Button android:id="@+id/menuFavorites" style="@style/MenuButton" android:text="FAVORITES"/>
        <Button android:id="@+id/menuSettings" style="@style/MenuButton" android:text="SETTINGS"/>
    </LinearLayout>
</LinearLayout>
