<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageButton android:id="@+id/backButton" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_top_icon" android:padding="8dp" android:src="@drawable/ic_back" android:contentDescription="@string/back"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" android:textColor="@color/adwio_text" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_subtitle" android:textColor="@color/adwio_muted" android:textSize="8.5sp"/></LinearLayout><ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_settings_modern"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_settings_section" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_playback" android:textColor="@color/adwio_cyan" android:textSize="10sp" android:textStyle="bold"/><Switch android:id="@+id/autoplaySwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_autoplay_last" android:textColor="@color/adwio_text" android:textSize="9.5sp"/><Switch android:id="@+id/rememberSwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_remember_position" android:textColor="@color/adwio_text" android:textSize="9.5sp"/><Switch android:id="@+id/backgroundSwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_background" android:textColor="@color/adwio_text" android:textSize="9.5sp"/><Switch android:id="@+id/pipSwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_pip" android:textColor="@color/adwio_text" android:textSize="9.5sp"/><Switch android:id="@+id/autoNextSwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_auto_next" android:textColor="@color/adwio_text" android:textSize="9.5sp"/><Switch android:id="@+id/refreshSwitch" android:layout_width="match_parent" android:layout_height="36dp" android:text="@string/setting_auto_refresh" android:textColor="@color/adwio_text" android:textSize="9.5sp"/></LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:background="@drawable/bg_settings_section" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_player" android:textColor="@color/adwio_magenta" android:textSize="10sp" android:textStyle="bold"/><Button android:id="@+id/streamFormatButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/decoderButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/bufferButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/aspectButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_settings_section" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_general" android:textColor="@color/adwio_green" android:textSize="10sp" android:textStyle="bold"/><Button android:id="@+id/languageButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/gridButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/startupButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/></LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="9dp" android:background="@drawable/bg_settings_section" android:orientation="vertical" android:padding="10dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_storage" android:textColor="#FFB86C" android:textSize="10sp" android:textStyle="bold"/><Button android:id="@+id/clearCacheButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_action" android:text="@string/clear_cache" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:text="@string/clear_history" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/resetSettingsButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="5dp" android:background="@drawable/bg_settings_action" android:text="@string/reset_settings" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/></LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="9dp" android:orientation="horizontal"><Button android:id="@+id/aboutButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_settings_action" android:text="@string/about_developer" android:textAllCaps="false" android:textColor="@color/adwio_cyan" android:textSize="9sp"/><Button android:id="@+id/logoutButton" android:layout_width="150dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:background="@drawable/bg_settings_action" android:text="@string/logout" android:textAllCaps="false" android:textColor="#FF9BAE" android:textSize="9sp"/></LinearLayout>
</LinearLayout></ScrollView>