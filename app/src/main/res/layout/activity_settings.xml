<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="420dp"
        android:orientation="horizontal"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textColor="@color/adwio_text"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <Switch
                android:id="@+id/autoplaySwitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Auto-play last channel"
                android:textColor="@color/adwio_text"
                android:focusable="true"/>

            <Switch
                android:id="@+id/rememberSwitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Remember movie/episode position"
                android:textColor="@color/adwio_text"
                android:focusable="true"/>

            <Switch
                android:id="@+id/refreshSwitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Auto refresh playlists"
                android:textColor="@color/adwio_text"
                android:focusable="true"/>

            <Button
                android:id="@+id/bufferButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="BUFFER MODE"
                android:background="@drawable/bg_focus"
                android:textColor="@color/adwio_text"/>

            <Button
                android:id="@+id/aspectButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:text="ASPECT RATIO"
                android:background="@drawable/bg_focus"
                android:textColor="@color/adwio_text"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                android:textColor="@color/adwio_muted"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/clearCacheButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="CLEAR CACHE"
                android:background="@drawable/bg_focus"
                android:textColor="@color/adwio_text"/>

            <Button
                android:id="@+id/clearHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:text="CLEAR WATCH HISTORY"
                android:background="@drawable/bg_focus"
                android:textColor="@color/adwio_text"/>

            <Button
                android:id="@+id/resetSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:text="RESET SETTINGS"
                android:background="@drawable/bg_focus"
                android:textColor="@color/adwio_text"/>

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:text="LOG OUT"
                android:background="@drawable/bg_focus"
                android:textColor="#FF9BAE"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
