<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="36dp"
    android:background="@drawable/bg_gradient">

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.6" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PLAYLIST" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/adwio_text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Manage your viewing profiles"
            android:textColor="@color/adwio_muted" android:textSize="16sp"/>
        <Button android:id="@+id/addPlaylistButton"
            android:layout_width="300dp" android:layout_height="70dp"
            android:layout_marginTop="48dp" android:focusable="true"
            android:text="+  ADD PLAYLIST" android:textColor="@color/adwio_text"
            android:textSize="18sp" android:background="@drawable/bg_focus"/>
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center"
        android:background="@drawable/bg_card" android:padding="32dp">
        <ImageView android:layout_width="84dp" android:layout_height="84dp" android:src="@drawable/ic_adwio"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="ADWIO PLAYER"
            android:textColor="@color/adwio_text" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:id="@+id/deviceInfoText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:gravity="center"
            android:textColor="@color/adwio_muted" android:textSize="14sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Ready"
            android:textColor="@color/adwio_green" android:textSize="15sp"/>
    </LinearLayout>
</LinearLayout>
