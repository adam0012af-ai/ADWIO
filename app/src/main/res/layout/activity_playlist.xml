<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="430dp"
        android:layout_height="255dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:src="@drawable/ic_adwio"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="إضافة مستخدم"
            android:textColor="@color/adwio_text"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="أضف بياناتك الخاصة للبدء"
            android:textColor="@color/adwio_muted"
            android:textSize="9sp"/>

        <Button
            android:id="@+id/addPlaylistButton"
            android:layout_width="250dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_focus"
            android:text="+  إضافة مستخدم"
            android:textAllCaps="false"
            android:textColor="@color/adwio_text"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
