<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.7"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYLISTS"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/adwio_text"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Choose a playlist or add a new one"
            android:textColor="@color/adwio_muted"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/addPlaylistButton"
            android:layout_width="260dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="+  ADD PLAYLIST"
            android:textColor="@color/adwio_text"
            android:textSize="15sp"
            android:background="@drawable/bg_focus"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:padding="22dp">

        <ImageView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:src="@drawable/ic_adwio"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ADWIO PLAYER"
            android:textColor="@color/adwio_text"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/deviceInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/adwio_muted"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="●  Ready"
            android:textColor="@color/adwio_green"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
