<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_adwio" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADWIO PLAYER"
                android:textColor="@color/adwio_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اختر قائمة محفوظة أو أضف قائمة جديدة"
                android:textColor="@color/adwio_muted"
                android:textSize="8.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/addPlaylistButton"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="+  إضافة قائمة"
            android:textAllCaps="false"
            android:textColor="@color/adwio_text"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="القوائم المحفوظة"
        android:textColor="@color/adwio_cyan"
        android:textSize="9sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center"
        android:text="ADWIO Player • مشغل وسائط وقوائم فقط"
        android:textColor="@color/adwio_muted"
        android:textSize="7.5sp" />

</LinearLayout>
