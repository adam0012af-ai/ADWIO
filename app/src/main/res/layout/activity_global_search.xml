<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_gradient" android:padding="18dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
  <Button android:id="@+id/backButton" android:layout_width="52dp" android:layout_height="48dp" android:text="‹" android:textSize="24sp" android:background="@drawable/bg_focus" android:textColor="@color/adwio_text"/>
  <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="12dp" android:hint="@string/search_all" android:singleLine="true" android:textColor="@color/adwio_text" android:textColorHint="@color/adwio_muted" android:paddingHorizontal="16dp" android:background="@drawable/bg_focus"/>
 </LinearLayout>
 <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/adwio_muted" android:textSize="13sp"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/resultsRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"/>
</LinearLayout>
