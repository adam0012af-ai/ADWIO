<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_adwio"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADWIO"
                    android:textColor="@color/adwio_text"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD PLAYLIST"
                    android:textColor="@color/adwio_muted"
                    android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>

        <RadioGroup
            android:id="@+id/sourceTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/xtreamRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:buttonTint="@color/adwio_accent"
                android:checked="true"
                android:gravity="center"
                android:text="Xtream Codes"
                android:textColor="@color/adwio_text"/>

            <RadioButton
                android:id="@+id/m3uRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:buttonTint="@color/adwio_accent"
                android:gravity="center"
                android:text="M3U URL"
                android:textColor="@color/adwio_text"/>
        </RadioGroup>

        <EditText
            android:id="@+id/playlistNameInput"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:hint="Playlist name"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/adwio_text"
            android:textColorHint="@color/adwio_muted"/>

        <LinearLayout
            android:id="@+id/xtreamFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Server URL"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted"/>

            <EditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Username"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="44dp"
                    android:singleLine="true"
                    android:textColor="@color/adwio_text"
                    android:textColorHint="@color/adwio_muted"/>

                <ImageButton
                    android:id="@+id/passwordEye"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="Show password"
                    android:padding="9dp"
                    android:src="@drawable/ic_eye"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/m3uFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/m3uUrlInput"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="M3U URL"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted"/>

            <EditText
                android:id="@+id/epgUrlInput"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="EPG URL (optional)"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted"/>
        </LinearLayout>

        <CheckBox
            android:id="@+id/rememberMe"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:buttonTint="@color/adwio_accent"
            android:checked="true"
            android:text="Save playlist"
            android:textColor="@color/adwio_muted"/>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textColor="#FFFF8585"
            android:textSize="8sp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="CONNECT"
                android:textAllCaps="true"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
