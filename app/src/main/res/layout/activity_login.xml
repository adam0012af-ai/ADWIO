<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient"
    android:overScrollMode="never">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="430dp"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="28dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_adwio" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="ADWIO"
                android:textColor="@color/adwio_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/playlistNameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_focus"
                android:hint="@string/playlist_name"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted" />

            <EditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focus"
                android:hint="@string/username"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/adwio_text"
                android:textColorHint="@color/adwio_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focus"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="@color/adwio_text"
                    android:textColorHint="@color/adwio_muted" />

                <ImageButton
                    android:id="@+id/passwordEye"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/show_password"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/adwio_text" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/rememberMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/remember_me"
                android:textColor="@color/adwio_text" />

            <Button
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_focus"
                android:text="@string/sign_in"
                android:textColor="@color/adwio_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#FF879A"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
