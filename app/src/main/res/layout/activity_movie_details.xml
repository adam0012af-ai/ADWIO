<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient" android:orientation="horizontal" android:padding="8dp">
<LinearLayout android:layout_width="145dp" android:layout_height="match_parent" android:orientation="vertical"><ImageButton android:id="@+id/backButton" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:padding="6dp" android:src="@drawable/ic_back" android:contentDescription="Back"/><ImageView android:id="@+id/posterImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:scaleType="centerCrop" android:src="@drawable/ic_adwio"/></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="center_vertical"><TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/adwio_text" android:textSize="19sp" android:textStyle="bold"/><TextView android:id="@+id/metaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/adwio_cyan" android:textSize="9.5sp"/><TextView android:id="@+id/infoText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="6" android:ellipsize="end" android:textColor="@color/adwio_muted" android:textSize="9.5sp"/><LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="10dp" android:orientation="horizontal"><Button android:id="@+id/playButton" android:layout_width="120dp" android:layout_height="match_parent" android:background="@drawable/bg_focus" android:text="تشغيل" android:textAllCaps="false" android:textColor="@color/adwio_text" android:textSize="9sp"/><Button android:id="@+id/favoriteButton" android:layout_width="140dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:background="@drawable/bg_card" android:textColor="@color/adwio_text" android:textAllCaps="false" android:textSize="9sp"/></LinearLayout></LinearLayout>
</LinearLayout>