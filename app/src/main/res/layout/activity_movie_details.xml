<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="28dp">
        <ImageView android:id="@+id/posterImage" android:layout_width="260dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/ic_adwio"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="28dp" android:orientation="vertical" android:gravity="center_vertical">
            <Button android:id="@+id/backButton" android:layout_width="60dp" android:layout_height="48dp" android:text="‹" android:textSize="24sp" android:background="@drawable/bg_focus" android:textColor="@color/adwio_text"/>
            <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/adwio_text" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:id="@+id/metaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/adwio_muted" android:textSize="15sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:orientation="horizontal">
                <Button android:id="@+id/playButton" android:layout_width="180dp" android:layout_height="match_parent" android:text="@string/play" android:background="@drawable/bg_focus" android:textColor="@color/adwio_text"/>
                <Button android:id="@+id/favoriteButton" android:layout_width="220dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:background="@drawable/bg_focus" android:textColor="@color/adwio_text"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
