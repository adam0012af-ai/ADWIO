<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <ImageView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_user_modern"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playlistNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/adwio_text"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/playlistServerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/adwio_cyan"
            android:textSize="8.5sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اضغط مطولاً للإدارة"
        android:textColor="@color/adwio_muted"
        android:textSize="7sp"/>
</LinearLayout>
