<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        app:surface_type="surface_view"
        app:use_controller="false"/>

    <ImageButton
        android:id="@+id/backControlButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="start|top"
        android:layout_margin="10dp"
        android:background="@drawable/bg_player_back"
        android:contentDescription="@string/back"
        android:elevation="4dp"
        android:padding="9dp"
        android:src="@drawable/ic_back"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/playerControls"
        android:layout_width="match_parent"
        android:layoutDirection="ltr"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_margin="9dp"
        android:background="@drawable/bg_control_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play pause"
            android:padding="7dp"
            android:src="@drawable/ic_pause"/>

        <TextView
            android:id="@+id/rewind15Button"
            android:layout_width="45dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="−15"
            android:contentDescription="@string/rewind_15"
            android:textColor="@color/adwio_text"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <SeekBar
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:max="1000"/>

        <TextView
            android:id="@+id/forward15Button"
            android:layout_width="45dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+15"
            android:contentDescription="@string/forward_15"
            android:textColor="@color/adwio_text"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/qualityText"
            android:layout_width="48dp"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/adwio_text"
            android:textSize="9sp"/>

        <ImageButton android:id="@+id/audioButton" android:layout_width="32dp" android:layout_height="32dp" android:background="@android:color/transparent" android:contentDescription="Audio" android:padding="7dp" android:src="@drawable/ic_audio"/>
        <ImageButton android:id="@+id/subtitleButton" android:layout_width="32dp" android:layout_height="32dp" android:background="@android:color/transparent" android:contentDescription="Subtitles" android:padding="7dp" android:src="@drawable/ic_subtitles"/>
        <ImageButton android:id="@+id/browseButton" android:layout_width="32dp" android:layout_height="32dp" android:background="@android:color/transparent" android:contentDescription="Channels" android:padding="7dp" android:src="@drawable/ic_list"/>
        <ImageButton android:id="@+id/zoomButton" android:layout_width="32dp" android:layout_height="32dp" android:background="@android:color/transparent" android:contentDescription="@string/aspect_ratio" android:padding="7dp" android:src="@drawable/ic_zoom"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveBrowseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.35"
            android:background="#B8070B17"
            android:orientation="horizontal"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_overlay_panel"
                android:orientation="vertical"
                android:padding="5dp">
                <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:text="@string/categories" android:textColor="@color/adwio_muted" android:textSize="9sp" android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/overlayCategoryRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_panel"
                android:orientation="vertical"
                android:padding="5dp">
                <TextView android:id="@+id/overlayChannelHeader" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:text="@string/live_title" android:textColor="@color/adwio_muted" android:textSize="9sp" android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/overlayChannelRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>

        <com.adwio.player.ui.player.LiveOverlayDismissView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.65"
            android:contentDescription="Close channels"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nextEpisodePanel"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_next_episode_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="13dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/nextEpisodeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_episode"
            android:textColor="#FF35D6FF"
            android:textSize="9sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/nextEpisodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/adwio_text"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/nextEpisodeCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/adwio_muted"
            android:textSize="8sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="9dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancelNextEpisodeButton"
                android:layout_width="82dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_next_episode_button_secondary"
                android:gravity="center"
                android:text="@string/cancel_next_episode"
                android:textColor="@color/adwio_text"
                android:textSize="8sp"/>

            <TextView
                android:id="@+id/playNextNowButton"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_next_episode_button_primary"
                android:gravity="center"
                android:text="@string/play_now"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:textColor="@color/adwio_text"
        android:textSize="10sp"
        android:visibility="gone"/>
</FrameLayout>
