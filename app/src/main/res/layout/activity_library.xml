<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/libraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="7dp">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_top_icon"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="@color/adwio_text"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/subtitleText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        <ImageButton android:id="@+id/searchButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@string/search"/>
        <ImageButton android:id="@+id/recentButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@string/recent"/>
        <ImageButton android:id="@+id/favoritesButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="@string/favorites"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/libraryContentRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/categoryPanel"
            android:layout_width="158dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_category_panel"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:gravity="center_vertical"
                android:text="@string/categories"
                android:textColor="@color/adwio_muted"
                android:textSize="9sp"
                android:textStyle="bold"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentRecycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0.95"
            android:clipToPadding="false"
            android:padding="2dp"/>

        <LinearLayout
            android:id="@+id/livePreviewPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_live_preview_premium"
            android:orientation="vertical"
            android:padding="5dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.adwio.player.ui.player.AdwioPreviewPlayerView
                    android:id="@+id/previewPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:clickable="true"
                    android:focusable="true"
                    app:surface_type="surface_view"
                    app:use_controller="false"/>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/previewFooter"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="#B8000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/previewBackButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/back"
                    android:padding="7dp"
                    android:src="@drawable/ic_back"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/previewChannelName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:textColor="@color/adwio_text"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/previewAspectButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/aspect_ratio"
                    android:padding="7dp"
                    android:src="@drawable/ic_zoom"
                    android:visibility="gone"/>

                <ImageButton
                    android:id="@+id/previewFullscreenButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/fullscreen"
                    android:padding="7dp"
                    android:src="@drawable/ic_zoom"/>
            </LinearLayout>

            <TextView android:id="@+id/previewNow" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
            <TextView android:id="@+id/previewNext" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
