<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient" android:orientation="vertical" android:padding="5dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="31dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageButton android:id="@+id/backButton" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:contentDescription="Back" android:padding="6dp" android:src="@drawable/ic_back"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/titleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/adwio_text" android:textSize="13sp" android:textStyle="bold"/><TextView android:id="@+id/subtitleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/adwio_muted" android:textSize="8sp"/></LinearLayout>
<ImageButton android:id="@+id/searchButton" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:contentDescription="Search" android:padding="6dp" android:src="@android:drawable/ic_menu_search" android:tint="@color/adwio_muted"/>
<ImageButton android:id="@+id/recentButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Recent"/>
<ImageButton android:id="@+id/favoritesButton" android:layout_width="28dp" android:layout_height="28dp" android:background="@android:color/transparent" android:contentDescription="Favorites" android:padding="6dp" android:src="@android:drawable/btn_star_big_off" android:tint="@color/adwio_muted"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="3dp" android:layout_weight="1" android:orientation="horizontal">
<LinearLayout android:layout_width="108dp" android:layout_height="match_parent" android:background="#55121019" android:orientation="vertical" android:padding="4dp"><TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:text="التصنيفات" android:textColor="@color/adwio_muted" android:textSize="8.5sp"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/categoryRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/></LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/contentRecycler" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:clipToPadding="false" android:padding="1dp"/>
<LinearLayout android:id="@+id/livePreviewPanel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="0.92" android:background="#45100E15" android:orientation="vertical" android:padding="4dp" android:visibility="gone"><androidx.media3.ui.PlayerView android:id="@+id/previewPlayer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000" app:use_controller="false"/><TextView android:id="@+id/previewChannelName" android:layout_width="match_parent" android:layout_height="25dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:textColor="@color/adwio_text" android:textSize="9.5sp" android:textStyle="bold"/><TextView android:id="@+id/previewNow" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/><TextView android:id="@+id/previewNext" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/></LinearLayout>
</LinearLayout></LinearLayout>