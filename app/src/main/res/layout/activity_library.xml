<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="7dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/backButton" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_player_back" android:contentDescription="Back" android:padding="8dp" android:src="@drawable/ic_back" />
        <TextView android:id="@+id/titleText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="@color/adwio_text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/subtitleText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <ImageButton android:id="@+id/searchButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Search" />
        <ImageButton android:id="@+id/recentButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Recent" />
        <ImageButton android:id="@+id/favoritesButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:contentDescription="Favorites" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="176dp" android:layout_height="match_parent" android:background="@drawable/bg_category_panel" android:orientation="vertical" android:padding="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:text="التصنيفات" android:textColor="@color/adwio_muted" android:textSize="9sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/categoryRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="4dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/contentRecycler" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:layout_weight="1" android:clipToPadding="false" android:padding="2dp" />

        <LinearLayout android:id="@+id/livePreviewPanel" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:orientation="vertical">
            <com.adwio.player.ui.player.AdwioPreviewPlayerView android:id="@+id/previewPlayer" android:layout_width="1dp" android:layout_height="1dp" app:use_controller="false" />
            <TextView android:id="@+id/previewChannelName" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/previewNow" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <TextView android:id="@+id/previewNext" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
