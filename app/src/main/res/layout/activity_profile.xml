<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_premium_root"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/backButton" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_top_icon" android:contentDescription="@string/back" android:padding="8dp" android:src="@drawable/ic_back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/user_information" android:textColor="@color/adwio_text" android:textSize="16sp" android:textStyle="bold"/>
        <View android:layout_width="34dp" android:layout_height="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_profile_premium"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="205dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView android:layout_width="92dp" android:layout_height="92dp" android:src="@drawable/ic_adwio"/>
            <TextView android:id="@+id/clientNameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/adwio_text" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/usernameText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="@color/adwio_muted" android:textSize="9sp"/>
            <TextView android:id="@+id/statusText" android:layout_width="104dp" android:layout_height="30dp" android:layout_marginTop="10dp" android:background="@drawable/bg_connect_premium" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="9sp" android:textStyle="bold"/>
        </LinearLayout>

        <GridLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:columnCount="2"
            android:rowCount="3">

            <TextView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:text="@string/account_type" android:textColor="@color/adwio_muted"/>
            <TextView android:id="@+id/sourceTypeText" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:textColor="@color/adwio_text" android:textStyle="bold"/>

            <TextView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:text="@string/expiry_date" android:textColor="@color/adwio_muted"/>
            <TextView android:id="@+id/expiryText" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:textColor="#FF35D6FF" android:textStyle="bold"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/active_connections" android:textColor="@color/adwio_muted" android:textSize="8sp"/>
                <TextView android:id="@+id/activeConnectionsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/adwio_text" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/max_connections" android:textColor="@color/adwio_muted" android:textSize="8sp"/>
                <TextView android:id="@+id/maxConnectionsText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/adwio_text" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>

            <TextView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:text="@string/created_date" android:textColor="@color/adwio_muted"/>
            <TextView android:id="@+id/createdText" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:background="@drawable/bg_home_quick" android:gravity="center" android:textColor="@color/adwio_text" android:textStyle="bold"/>
        </GridLayout>
    </LinearLayout>
</LinearLayout>
