<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_live_channel_premium"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="6dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#12000000"
            android:padding="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_adwio"/>

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="2dp"
            android:background="@drawable/bg_live_dot"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/adwio_text"
            android:textSize="10.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/metaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/adwio_muted"
            android:textSize="7.2sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/favoriteText"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:text="☆"
        android:textColor="@color/adwio_cyan"
        android:textSize="14sp"/>
</LinearLayout>