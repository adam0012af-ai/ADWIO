<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7B2CFF" android:endColor="#D62CFF"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="#30D5FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#211A31"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</selector>
