<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:angle="0" android:startColor="#2635D6FF" android:endColor="#18151E2E"/>
            <stroke android:width="1dp" android:color="#8035D6FF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#2435D6FF"/>
            <stroke android:width="1dp" android:color="#AA35D6FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:angle="0" android:startColor="#D50B1422" android:endColor="#D50A101B"/>
            <stroke android:width="1dp" android:color="#283E526B"/>
        </shape>
    </item>
</selector>