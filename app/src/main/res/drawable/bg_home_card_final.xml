<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:angle="315" android:startColor="#2B1A5C7A" android:centerColor="#2E1D315F" android:endColor="#29100E22"/>
            <stroke android:width="2dp" android:color="@color/adwio_cyan"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient android:angle="315" android:startColor="#1D17354E" android:centerColor="#1B14243A" android:endColor="#18101824"/>
            <stroke android:width="1dp" android:color="#344B6B9E"/>
        </shape>
    </item>
</selector>
