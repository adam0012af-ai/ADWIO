    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <solid android:color="#A30A1727"/>
            <stroke android:width="1dp" android:color="#2B2A405B"/>
        </shape>
    </item>
</selector>
